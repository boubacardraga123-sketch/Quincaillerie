{
  "name": "quincaillerie-diallo",
  "version": "1.0.0",
  "description": "ETS. DIALLO AMADOU OURY — Gestion Stock & Factures",
  "main": "main.js",
  "author": "Boubacar Diallo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.etsdialloamadououry.quincaillerie",
    "productName": "Quincaillerie Diallo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quincaillerie Diallo"
    }
  }
}
