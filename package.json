{
  "name": "quincaillerie-diallo",
  "version": "1.0.0",
  "description": "Gestion des factures - ETS. DIALLO AMADOU OURY",
  "main": "main.js",
  "author": "ETS. DIALLO AMADOU OURY",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.diallo.quincaillerie",
    "productName": "Gestion Factures DIALLO",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gestion Factures DIALLO"
    }
  }
}
